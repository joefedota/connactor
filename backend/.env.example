# TMDB API Credentials
# Get your free credentials at https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_api_key_here
TMDB_API_READ_TOKEN=your_v4_bearer_token_here

# Neo4j Graph Database
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=connactorpassword

# Postgres (Neon in prod, local docker in dev)
# Dev: postgresql+asyncpg://connactor:connactorpassword@localhost:5432/connactor
# Prod: postgresql+asyncpg://<user>:<pass>@<neon-host>/neondb?ssl=require
DATABASE_URL=postgresql+asyncpg://connactor:connactorpassword@localhost:5432/connactor

# Cookie signing secret — generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
COOKIE_SECRET=dev-cookie-secret-change-in-prod

# GCP
GCS_BUCKET=connactor-data
GCP_PROJECT=connactor-497019

# Cost report (optional)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_TAG=
RESEND_API_KEY=
REPORT_RECIPIENT=joefedota@gmail.com
REPORT_SENDER=reports@connactor.com
