# Frontend environment variables.
#
# Local dev does NOT need this file — the Vite dev server proxies /api to
# http://localhost:8000 (see vite.config.ts), so the default fallback in
# src/api/client.ts (`/api`) works without any env config.
#
# In production (Cloudflare Pages) this is set in the Pages project's
# build environment variables, not committed to the repo:
#
#   VITE_API_URL=https://api.connactor.com
